# Vercel / Lovable deployment
#
# Copy to .env (or set these in the Vercel dashboard) and fill in.
# NEVER commit the filled-in file.

# Local Vite defaults to its /api proxy. Set this only to use a different API.
VITE_API_URL=

# Vercel server-side variables for frontend/api/proxy.js. Set these in the
# Vercel project settings; do not prefix them with VITE_ or expose them in the
# browser bundle.
# e.g. https://abcdefghijklmnop.supabase.co/functions/v1/api
SUPABASE_FUNCTION_URL=
SUPABASE_ANON_KEY=
