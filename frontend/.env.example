# Vercel / Lovable deployment
#
# Copy to .env (or set these in the Vercel dashboard) and fill in.
# NEVER commit the filled-in file.

# Supabase project URL: https://<ref>.supabase.co
VITE_SUPABASE_URL=

# The anon key. This one is safe in the browser bundle -- it is the public key,
# and the schema enables RLS with no policies so it grants no data access.
VITE_SUPABASE_ANON_KEY=

# The deployed edge function URL, from: supabase functions list
# e.g. https://abcdefghijklmnop.supabase.co/functions/v1/api
VITE_SUPABASE_FUNCTION_URL=
