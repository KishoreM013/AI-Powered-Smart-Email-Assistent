# ---- Smart Email Assistant, Firebase backend
#
# There is NO .env file on Cloud Functions. Set each value with:
#
#   firebase functions:secrets:set JWT_SECRET
#
# then declare it in functions/src/index.ts with defineSecret(). A secret that
# is only present as a plain environment variable is also valid, but it shows up
# in the Firebase console in plaintext; the secrets API encrypts it at rest.
#
# Do NOT commit real values. The service account key must never be in this
# repository -- the runtime uses Application Default Credentials instead.

ENVIRONMENT=production
DEMO_MODE=False

# ---- required
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Encrypts OAuth refresh tokens in Firestore (AES-256-GCM).
# Must be different from JWT_SECRET, and must not change once set: changing it
# makes every stored refresh token undecryptable and forces users to re-link.
CREDENTIAL_ENCRYPTION_KEY=

# ---- Google OAuth
# The redirect URI must be registered in the Google Cloud console AND must
# match GOOGLE_CLIENT_ID's authorised redirect URIs exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ---- Gemini (optional)
# Without a key the app still runs: summarise/classify/extract fall back to the
# deterministic rules in services/localRules.ts.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=30

# ---- limits
MAX_SYNC_EMAILS=50
IMAP_MAX_EMAILS=50

# ---- frontend
# In production, /api/** is rewritten to the function by Firebase Hosting, so
# the browser is same-origin and CORS is not involved. These matter for local
# development and for calling the function URL directly.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
